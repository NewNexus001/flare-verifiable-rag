# Flare Verifiable RAG — enclave environment template.
# Copy to .env and fill in. NEVER commit .env (gitignored); NEVER paste keys in chat.
#
# DANGER (dev.flare.network): never share private keys, never commit them to
# git, never put them in source code. .env is gitignored.

# Dedicated enclave signer key (32 bytes = 64 hex chars, 0x prefix optional).
# Generate a FRESH one — never reuse the deployer key:
#   openssl rand -hex 32        (then optionally prefix with 0x)
# ENCLAVE_ATTESTER_KEY=

# FlareContractRegistry bootstrap — public constant, identical on every Flare
# network (Coston2 included). Documented in REAL-DATA-SOURCES.md.
FLARE_CONTRACT_REGISTRY=0xaD67FE66660Fb8dFE9d6b1b4240d8650e30F6019

# Optional overrides (defaults below; see src/config.py):
