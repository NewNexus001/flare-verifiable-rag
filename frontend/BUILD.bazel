# BUILD.bazel — frontend domain (Next.js dashboard).
#
# Phase 16 (Prompt 305): the dashboard's TypeScript sources are compiled
# with aspect_rules_js / aspect_rules_ts — the maintained successor to
# rules_nodejs (which is deprecated). The npm dependency graph is resolved
# from the pnpm lockfile (pnpm-lock.yaml at the repo root) via
# npm_translate_lock, so Bazel and pnpm share one source of truth.
#
# NOTE on platform compatibility: aspect_rules_js (v3.4.0, the latest
# release) resolves js_binary tool entry points through the TARGET
# configuration bindir even when the tool runs in the EXEC configuration.
# On Windows (where Bazel cannot build runfiles trees) that check fails
# with "entry_point not found" — an upstream bug, not this repo's code.
# The clean Bazel mechanism is target_compatible_with: these targets are
# restricted to Linux, where the hermetic compile runs (CI executes this
# build on ubuntu runners). On Windows the targets are skipped as
# incompatible and the dashboard is built the normal way (pnpm build).

package(default_visibility = ["//visibility:public"])

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

LINUX_ONLY = ["@platforms//os:linux"]

# TypeScript typecheck + compilation of the application sources.
# Emits to bazel-out; the Next.js build consumes the compiled output.
# npm links live at the monorepo root (//:node_modules/...) because the
# pnpm workspace resolves at the root.
ts_project(
    name = "tsc",
    srcs = glob(
        ["src/**/*.ts", "src/**/*.tsx"],
        exclude = ["src/**/*.test.ts", "src/**/*.test.tsx"],
    ),
    tsconfig = "tsconfig.json",
    transpiler = "tsc",
    target_compatible_with = LINUX_ONLY,
    # Skip the tsconfig-vs-attribute cross-check validator (its js_binary
    # entry point resolution is broken under Windows; on Linux the tsc
    # compile itself is the real typecheck).
    validate = False,
    # Version-qualified npm link targets (generated by npm_link_all_packages
    # at the root from pnpm-lock.yaml; names verified with bazel query).
    deps = [
        "//:.aspect_rules_js/node_modules/next@14.2.35_2070892314",
        "//:.aspect_rules_js/node_modules/react@18.2.0",
        "//:.aspect_rules_js/node_modules/react-dom@18.2.0_react@18.2.0",
        "//:.aspect_rules_js/node_modules/viem@2.8.18_483192477",
        "//:.aspect_rules_js/node_modules/wagmi@2.5.11_1149128214",
        "//:.aspect_rules_js/node_modules/@rainbow-me+rainbowkit@2.0.2_1570158639",
        "//:.aspect_rules_js/node_modules/framer-motion@11.0.24_815441617",
        "//:.aspect_rules_js/node_modules/lucide-react@0.359.0_react@18.2.0",
    ],
)

# App-level aggregation for `bazel build //frontend:all`.
js_library(
    name = "frontend_all",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx"]) + [
        "tsconfig.json",
        "next.config.mjs",
        "package.json",
    ],
    deps = [":tsc"],
    target_compatible_with = LINUX_ONLY,
)

# Everything in this package (referenced by the root //:frontend alias).
alias(
    name = "all",
    actual = ":tsc",
    target_compatible_with = LINUX_ONLY,
)
