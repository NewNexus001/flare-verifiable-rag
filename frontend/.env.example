# Flare Verifiable RAG — frontend environment template.
# Copy to .env.local (gitignored). NEXT_PUBLIC_* values are inlined at build
# time; they are PUBLIC by design (they ship to the browser). Never put
# private keys here.

# The DEPLOYED VerifiableRAG contract on Coston2 (Phase 8 / P158, live).
NEXT_PUBLIC_CONTRACT_ADDRESS=0x403be0A89183078e4eC09e7E61b9F0EE3c5E9897

# FtsoV2 resolved LIVE from the FlareContractRegistry (docs value for the
# decimals read; the contract itself always resolves it at runtime).
NEXT_PUBLIC_FTSO_V2_ADDRESS=0xC4e9c78EA53db782E28f28Fdf80BaF59336B304d

# Canonical Coston2 RPC (REAL-DATA-SOURCES.md).
NEXT_PUBLIC_COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# OPTIONAL: WalletConnect Cloud project id (cloud.walletconnect.com) — enables
# the WalletConnect wallet option in the connect modal. Without it, the app
# connects via browser-injected wallets (MetaMask etc.).
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# OPTIONAL: Sentry DSNs (client / server crash reporting).
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# Enclave base URL (SERVER-side only — never NEXT_PUBLIC). The blind proxy
# routes (api/enclave/*) relay /health, /v1/attestation and /v1/query to it;
# the browser never sees this address. When unset, the proxy routes respond
# 503 "unconfigured" honestly (zero-mock policy).
# ENCLAVE_URL=http://127.0.0.1:8000
